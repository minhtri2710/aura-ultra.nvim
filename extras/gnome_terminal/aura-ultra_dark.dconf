# Import this theme as follows:
# 1. Create a new profile for GNOME Terminal
# 2. Copy the UUID of the new profile (bottom right corner of the preferences window)
# 3. Replace <PROFILE_UUID> below with the copied UUID
# 4. Execute `dconf load /org/gnome/terminal/legacy/profiles:/ < aura-ultra_dark.dconf`

[:<PROFILE_UUID>]
background-color='rgb(42, 31, 61)'
cursor-background-color='rgb(237, 236, 238)'
cursor-colors-set=true
cursor-foreground-color='rgb(42, 31, 61)'
foreground-color='rgb(237, 236, 238)'
highlight-background-color='rgb(237, 236, 238)'
highlight-colors-set=true
highlight-foreground-color='rgb(42, 31, 61)'
palette=['rgb(120, 99, 149)', 'rgb(255, 103, 103)', 'rgb(97, 255, 202)', 'rgb(255, 212, 155)', 'rgb(130, 226, 255)', 'rgb(246, 148, 255)', 'rgb(114, 241, 229)', 'rgb(237, 236, 238)', 'rgb(120, 99, 149)', 'rgb(255, 103, 103)', 'rgb(97, 255, 202)', 'rgb(255, 212, 155)', 'rgb(130, 226, 255)', 'rgb(246, 148, 255)', 'rgb(114, 241, 229)', 'rgb(237, 236, 238)']
use-theme-colors=false
visible-name='Aura Ultra'
